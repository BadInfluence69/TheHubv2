# ============================================================================
# The Hub — configuration
#
# Copy this file to `.env` and edit it. `.env` is gitignored; this one isn't,
# so never put a real secret in here.
#
#     cp .env.example .env
# ============================================================================

# ------------------------------------------------------------------
PROXY=false
# ------------------------------------------------------------------

# ---------------------------------------------------------------- required --
# Signs session cookies and encrypts the stored Google token. If this changes,
# everyone is signed out and any connected Google account must be reconnected.
# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=

# ------------------------------------------------------------------ server --
HOST=0.0.0.0
PORT=5003

# Leave DEBUG off unless you're actively developing. It exposes a Python
# console to anyone who can reach the server.
DEBUG=false

# The address other devices on your network use to reach this server. Only
# needed if auto-detection picks the wrong interface (VPNs, multiple NICs).
#PUBLIC_HOST=192.168.0.142

# Set to true only if you're serving over HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_DAYS=365

# Largest file the server will accept in one upload, in megabytes.
MAX_UPLOAD_MB=4096

# Turn this off once everyone who needs an account has one.
ALLOW_REGISTRATION=true

# ----------------------------------------------------------- media library --
# Your local video folders as a JSON object of {shelf name: path}. Each entry
# becomes its own section in the Local files page. Add as many as you like.
#
# Windows paths: use forward slashes or double backslashes.
#
# MEDIA_LIBRARY={"Movies": "E:/Media/Movies", "TV": "E:/Media/TV"}
#
# Or, for the common layout, point at one root and get Movies + TV for free:
#MEDIA_ROOT=E:/Media/



# ------------------------------------------------------------ external tools --
# Export cookies from a browser extension if you want age-restricted or
# members-only videos to resolve.
 #COOKIES_FILE=./cookies.txt

COOKIES_FILE=./cookies.txt
# --------------------------------------------------- YouTube search (optional) --
# An API key makes search faster and more reliable. Without one, The Hub reads
# YouTube's public results page instead, which works but can break when they
# change their markup.
#
# Get one at console.cloud.google.com → APIs & Services → Credentials → API key,
# with the YouTube Data API v3 enabled.
YOUTUBE_API_KEY=


# ------------------------------------------------- YouTube upload (OAuth) --
# Uploading acts on your behalf, so an API key can't do it — you need OAuth.
#
#   1. console.cloud.google.com → create a project
#   2. Enable "YouTube Data API v3"
#   3. Credentials → Create credentials → OAuth client ID → Web application
#   4. Add this authorised redirect URI:
#        http://localhost:5002/studio/oauth/callback
#      (match the host and port you actually use)
#   5. Download the JSON, save it as client_secret.json beside run.py
#
# Or skip the file and paste the two values here instead:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Override if the auto-built callback URL doesn't match what you registered.
# OAUTH_REDIRECT_URI=http://localhost:5002/studio/oauth/callback

# Google only allows plain http for localhost redirects. If you reach the app
# by LAN IP, either register that exact URI or put HTTPS in front of it.
OAUTH_INSECURE_TRANSPORT=true
# ---------------------------------------------------------------- behaviour --
# How long a resolved stream URL is reused before re-resolving, in seconds.
STREAM_CACHE_TTL=3000

# How many results to pull per search.
SEARCH_RESULTS=35

# Mark sponsor segments on the timeline where SponsorBlock has data.
SPONSORBLOCK=true

# Failed sign-ins allowed per IP per five minutes.
LOGIN_RATE_LIMIT=10

# Records IP address and browser user-agent alongside each session, so you can
# spot a session you don't recognise. Set to 0 to stop collecting either — the
# privacy page tells your users this switch exists, so it has to keep working.
STORE_SESSION_IP=1

# Only needed if the binaries aren't next to run.py and aren't on PATH.
# yt-dlp changes often because YouTube does — keep it updated with:
#     pip install -U yt-dlp
# YTDLP_PATH=C:/tools/yt-dlp.exe
# FFMPEG_PATH=C:/tools/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffprobe.exe

 # Tubi publishes no search API, so search reads their JSON endpoints and then
# their search page. This adds a headless browser as a third fallback. Off by
# default: slow, and needs `pip install playwright && playwright install chromium`.
TUBI_USE_PLAYWRIGHT=1

# How long a resolved stream URL is reused, in seconds. These expire at the
# source, so don't push this much past 300.
STREAM_CACHE_TTL=300
SEARCH_RESULTS=35

# Search phrases per feed build. Each search.list call costs 100 quota units
# against a default 10,000/day, so 4 is about 40 feed builds a day before the
# 5-minute cache is counted. Raise only if Google gave you more quota.
RECOMMEND_QUERIES=4

# Ceiling on how much of one feed a single channel or topic may fill.
RECOMMEND_MAX_SHARE=0.30

# How long the same search phrases are reused, so the feed doesn't reshuffle
# on every page load.
RECOMMEND_ROTATE_MINUTES=25

# Operator-only engagement figures. Admin accounts get in; everyone else gets
# an ordinary 404, so the page reads as non-existent rather than forbidden.
METRICS_ENABLED=1

# Where the dashboard is mounted. Moving it to something unguessable keeps the
# URL out of logs and casual poking. The admin check is what actually protects
# it — the path is a convenience, never the protection.
# METRICS_PATH=/ops-a7f3d219

# Off by default: nothing in the interface links to the dashboard and you reach
# it by typing the URL. Set to 1 to show a sidebar entry, which is still only
# ever drawn for admin accounts.
METRICS_SHOW_LINK=1

# Threads, not processes, and deliberately ONE worker. Background upload jobs
# live in the same process as the request that started them, so a second worker
# would lose track of them. It also keeps SQLite to a single writing process,
# which is the arrangement it's happiest with.
WEB_WORKERS=1

# Defaults to CPU count x 4, minimum 8. Most of these threads sit waiting on
# yt-dlp, ffmpeg, and network calls rather than using CPU, so a high number is
# fine — 32 to 64 is reasonable on a busy server.
 WEB_THREADS=64

# Seconds before a worker is killed. Long because video responses stream for a
# long time.
WEB_TIMEOUT=6000


