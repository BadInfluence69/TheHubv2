+    /* ---------------------------------------------------------- cdn direct */
+    /*
+       Local files stream from the CDN edge, not from this server. The signed
+       URL expires, so two things can go wrong mid-watch: the tab was left
+       paused past the TTL, or the edge 403s on a seek. Both are fixed by
+       asking the server for a fresh URL — a few hundred bytes of JSON — and
+       putting the playhead back where it was.
+    */
+    async function freshMediaUrl() {
+        const data = await Hub.api(`/api/media/${encodeURIComponent(videoId)}/url`);
+        return data && data.url ? data : null;
+    }
+
+    function swapSource(url) {
+        if (!video) return;
+        const at = video.currentTime;
+        const wasPlaying = !video.paused;
+        video.src = url;
+        video.load();
+        video.addEventListener(
+            "loadedmetadata",
+            () => {
+                if (at) video.currentTime = at;
+                if (wasPlaying) video.play().catch(() => {});
+            },
+            { once: true }
+        );
+    }
+
+    function initCdnDirect() {
+        if (!video || !videoId || !String(videoId).startsWith("local_")) return;
+
+        let expiresAt = Number(config.expiresAt || 0);
+        let resigning = false;
+
+        async function resign() {
+            if (resigning) return;
+            resigning = true;
+            try {
+                const data = await freshMediaUrl();
+                if (data) {
+                    expiresAt = Number(data.expires_at || 0);
+                    swapSource(data.url);
+                }
+            } catch (err) {
+                Hub.toast && Hub.toast("Couldn't refresh the media link", "error");
+            } finally {
+                resigning = false;
+            }
+        }
+
+        // The edge rejected us — almost always an expired signature.
+        video.addEventListener("error", () => {
+            const code = video.error && video.error.code;
+            if (code === 2 || code === 4) resign();
+        });
+
+        // Left paused past the TTL: re-sign before the next play attempt.
+        video.addEventListener("play", () => {
+            if (expiresAt && Date.now() / 1000 > expiresAt - 60) resign();
+        });
+    }
+
